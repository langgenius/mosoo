{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Keep this config focused on non-default runtime, script, and test entrypoints.
  // Library package src/index.ts files are already discovered from package exports.
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "includeEntryExports": false,
      "entry": ["config/**/*.ts", "scripts/**/*.ts"],
      "project": ["config/**/*.d.ts", "config/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": [
        "@graphql-codegen/client-preset",
        "@graphql-codegen/schema-ast",
        "@j178/prek",
        "tsx",
      ],
    },
    "apps/api": {
      "includeEntryExports": false,
      "entry": ["bin/**/*.ts", "src/adapters/graphql/codegen-schema.ts", "tests/**/*.test.ts"],
      "project": ["bin/**/*.ts", "src/**/*.ts!", "tests/**/*.ts"],
      "ignoreDependencies": ["wrangler"],
    },
    "apps/driver": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "apps/web": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "src/**/*.tsx!", "src/**/*.css!", "tests/**/*.ts"],
      "ignoreDependencies": ["wrangler"],
    },
    "e2e": {
      "includeEntryExports": false,
      "entry": ["playwright.config.ts", "cases/**/*.spec.ts"],
      "project": ["**/*.ts"],
      "playwright": false,
    },
    "pkgs/ag-ui-session": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/id": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts", "tests/**/*.typecheck.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/db": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/contracts": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["models/**/*.ts!", "src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/agent-package": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/runtime-catalog": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/runtime-events": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/session-policy": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/skill-package": {
      "includeEntryExports": false,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "pkgs/development-auth": {
      "includeEntryExports": false,
      "project": ["src/**/*.ts!"],
    },
    "pkgs/effects": {
      "includeEntryExports": false,
      "project": ["src/**/*.ts!"],
    },
    "pkgs/observability": {
      "includeEntryExports": false,
      "project": ["src/**/*.ts!"],
    },
  },
  "ignore": ["apps/driver/src/runtimes/openai/generated/**"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
}
